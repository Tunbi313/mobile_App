<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC000000"
    android:gravity="center">

    <!-- Nút đóng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/btnCloseQr"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:tint="@color/white"
            android:contentDescription="Đóng"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Hướng dẫn -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quét mã QR để chuyển khoản"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="20dp" />

    <!-- QR Code to -->
    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="280dp"
        android:layout_height="280dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/qr_payment"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="QR Code thanh toán" />
    </androidx.cardview.widget.CardView>

    <!-- Logo VietQR -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VietQR • Napas 247"
        android:textSize="13sp"
        android:textColor="#CCFFFFFF"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chụp màn hình để lưu mã QR"
        android:textSize="12sp"
        android:textColor="#99FFFFFF" />

</LinearLayout>
