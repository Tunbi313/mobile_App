<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== ẢNH PHÒNG + NÚT BACK ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="260dp">

                <ImageView
                    android:id="@+id/ivRoomImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_house"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ảnh phòng" />

                <!-- Nút Back -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Quay lại" />
                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- ===== CONTENT CARD (đè lên ảnh) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F6FA"
                android:paddingTop="0dp">

                <!-- Card thông tin chính -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="4dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="-24dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Tên phòng -->
                        <TextView
                            android:id="@+id/tvRoomName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phòng 302"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:layout_marginBottom="4dp" />

                        <!-- Địa chỉ -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location"
                                android:tint="@color/text_hint"
                                android:contentDescription="Địa chỉ"
                                android:layout_marginEnd="4dp" />
                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hà Nội"
                                android:textSize="13sp"
                                android:textColor="@color/text_hint" />
                        </LinearLayout>

                        <!-- Giá -->
                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3.500.000 đ/tháng"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#22C55E"
                            android:layout_marginBottom="16dp" />

                        <!-- 3 thông số: Diện tích, Sức chứa, Tầng -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <!-- Diện tích -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_box"
                                android:layout_marginEnd="8dp"
                                android:padding="12dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_manage"
                                    android:tint="@color/primary"
                                    android:contentDescription="Diện tích"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Diện tích"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_hint" />
                                <TextView
                                    android:id="@+id/tvArea"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20m2"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- Sức chứa -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_box"
                                android:layout_marginEnd="8dp"
                                android:padding="12dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_user"
                                    android:tint="@color/primary"
                                    android:contentDescription="Sức chứa"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sức chứa"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_hint" />
                                <TextView
                                    android:id="@+id/tvCapacity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3 người"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>

                            <!-- Tầng -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_stat_box"
                                android:padding="12dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_house"
                                    android:tint="@color/primary"
                                    android:contentDescription="Tầng"
                                    android:layout_marginBottom="4dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tầng"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_hint" />
                                <TextView
                                    android:id="@+id/tvFloor"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tầng 2"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- ===== TIỆN ÍCH SẴN CÓ ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@color/primary"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiện ích sẵn có"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Grid tiện ích 2 cột -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="8dp">

                        <!-- Wifi -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="14dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardBackgroundColor="#EEF2FF"
                                    app:cardElevation="0dp"
                                    android:layout_marginEnd="10dp">
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_wifi"
                                        android:tint="@color/primary"
                                        android:contentDescription="Wifi" />
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Wifi"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Rác -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="14dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardBackgroundColor="#EEF2FF"
                                    app:cardElevation="0dp"
                                    android:layout_marginEnd="10dp">
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_trash"
                                        android:tint="@color/primary"
                                        android:contentDescription="Rác" />
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rác"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="20dp">

                        <!-- Máy giặt -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="14dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardBackgroundColor="#EEF2FF"
                                    app:cardElevation="0dp"
                                    android:layout_marginEnd="10dp">
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_switch"
                                        android:tint="@color/primary"
                                        android:contentDescription="Máy giặt" />
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Máy giặt"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Bãi xe -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="12dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="14dp">
                                <androidx.cardview.widget.CardView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardBackgroundColor="#EEF2FF"
                                    app:cardElevation="0dp"
                                    android:layout_marginEnd="10dp">
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_car"
                                        android:tint="@color/primary"
                                        android:contentDescription="Bãi xe" />
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bãi xe"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- ===== NÚT LIÊN HỆ ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1"
                        android:layout_marginBottom="20dp">

                        <Button
                            android:id="@+id/btnContact"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:text="LIÊN HỆ CHỦ TRỌ NGAY"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:textAllCaps="true"
                            android:background="@drawable/bg_button_primary"
                            android:drawableStart="@drawable/ic_phone"
                            android:drawableTint="@color/white"
                            android:drawablePadding="8dp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnMessage"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            app:cardCornerRadius="26dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="2dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_message"
                                android:tint="@color/primary"
                                android:contentDescription="Nhắn tin" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- ===== MÔ TẢ CHI TIẾT ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:background="@color/primary"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mô tả chi tiết"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardElevation="1dp"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Phòng trọ mới xây, sạch sẽ, thoáng mát tại khu vực an ninh Quận 7. Không gian phòng được thiết kế tối ưu với cửa sổ lớn đón ánh sáng tự nhiên và gió trời, giúp căn phòng luôn thông thoáng.\n\nVị trí thuận lợi, gần các trường đại học lớn (RMIT, Tôn Đức Thắng) và các trung tâm thương mại (Lotte Mart, SC VivoCity). Khu vực không ngập nước, giờ giấc tự do, không chung chủ."
                                android:textSize="14sp"
                                android:textColor="@color/text_hint"
                                android:lineSpacingExtra="4dp"
                                android:layout_marginBottom="12dp" />

                            <!-- Bullet points -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="•"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Khu vực bếp riêng biệt, sạch sẽ."
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="•"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Toilet trong phòng hiện đại, thiết bị cao cấp."
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="6dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="•"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Bãi giữ xe rộng rãi, có camera an ninh 24/7."
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="•"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint"
                                    android:layout_marginEnd="8dp" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Hệ thống phòng cháy chữa cháy đạt chuẩn."
                                    android:textSize="14sp"
                                    android:textColor="@color/text_hint" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
